{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marknexia.dev/compat/schema/marknexia-parity-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "area", "name", "input", "virtualFileSystem", "expected", "sourceRevision"],
  "properties": {
    "schemaVersion": { "const": "marknexia-parity-v1" },
    "area": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "input": { "type": ["object", "array", "string", "number", "boolean", "null"] },
    "virtualFileSystem": { "type": ["object", "null"] },
    "expected": { "type": ["object", "array", "string", "number", "boolean", "null"] },
    "sourceRevision": { "type": "string", "minLength": 1 }
  }
}
