    "html": "\u003C!DOCTYPE html\u003E\n\u003Chtml lang=\u0022en\u0022 data-theme=\u0022system\u0022\u003E\n\u003Chead\u003E\n  \u003Cmeta charset=\u0022utf-8\u0022 /\u003E\n  \u003Cmeta name=\u0022viewport\u0022 content=\u0022width=device-width, initial-scale=1.0\u0022 /\u003E\n  \u003Cbase href=\u0022https://document-{volatile}.marknexia.viewer/compat/\u0022 /\u003E\n  \u003Cmeta http-equiv=\u0022Content-Security-Policy\u0022 content=\u0022default-src \u0026#39;none\u0026#39;; base-uri https://document-{volatile}.marknexia.viewer; script-src \u0026#39;nonce-{volatile}\u0026#39; https://marknexia.assets; style-src \u0026#39;unsafe-inline\u0026#39;; img-src https://document-{volatile}.marknexia.viewer data:; font-src \u0026#39;none\u0026#39;; object-src \u0026#39;none\u0026#39;; frame-src \u0026#39;none\u0026#39;; connect-src \u0026#39;none\u0026#39;; form-action \u0026#39;none\u0026#39;\u0022 /\u003E\n  \u003Cstyle\u003E\n:root {\n  --color-canvas-default: #ffffff;\n  --color-canvas-subtle: #f1f5f9;\n  --color-border-default: #cbd5e1;\n  --color-border-muted: #e2e8f0;\n  --color-fg-default: #0f172a;\n  --color-fg-muted: #64748b;\n  --color-fg-subtle: #94a3b8;\n  --color-accent-fg: #2563eb;\n  --color-accent-emphasis: #1e40af;\n  --color-danger-fg: #cf222e;\n  --color-success-fg: #1a7f37;\n  --color-attention-fg: #9a6700;\n  --color-severe-fg: #bc4c00;\n  --color-scale-gray-1: #eaeef2;\n  --marknexia-control-hover: #eaeef2;\n  --marknexia-focus: #06b6d4;\n  --marknexia-on-primary: #ffffff;\n  --marknexia-important: #8250df;\n  --marknexia-search-current-background: #60a5fa;\n  --marknexia-search-current-foreground: #0f172a;\n  --font-body: \u0022Segoe UI Variable\u0022, \u0022Segoe UI\u0022, sans-serif;\n  --font-mono: \u0022Cascadia Code\u0022, Consolas, monospace;\n}\n\n@media (prefers-color-scheme: dark) {\n  [data-theme=\u0022system\u0022] {\n    --color-canvas-default: #171a1c;\n    --color-canvas-subtle: #24292c;\n    --color-border-default: #485054;\n    --color-border-muted: #353b3e;\n    --color-fg-default: #f1f4ef;\n    --color-fg-muted: #aab2b0;\n    --color-fg-subtle: #707876;\n    --color-accent-fg: #b7ff3c;\n    --color-accent-emphasis: #8fd622;\n    --color-danger-fg: #ff6577;\n    --color-success-fg: #68e875;\n    --color-attention-fg: #ffc857;\n    --color-severe-fg: #ffc857;\n    --color-scale-gray-1: #303639;\n    --marknexia-control-hover: #383f42;\n    --marknexia-focus: #b7ff3c;\n    --marknexia-on-primary: #172000;\n    --marknexia-important: #62c3ff;\n    --marknexia-search-current-background: #b7ff3c;\n    --marknexia-search-current-foreground: #172000;\n  }\n}\n\n[data-theme=\u0022dark\u0022] {\n  --color-canvas-default: #171a1c;\n  --color-canvas-subtle: #24292c;\n  --color-border-default: #485054;\n  --color-border-muted: #353b3e;\n  --color-fg-default: #f1f4ef;\n  --color-fg-muted: #aab2b0;\n  --color-fg-subtle: #707876;\n  --color-accent-fg: #b7ff3c;\n  --color-accent-emphasis: #8fd622;\n  --color-danger-fg: #ff6577;\n  --color-success-fg: #68e875;\n  --color-attention-fg: #ffc857;\n  --color-severe-fg: #ffc857;\n  --color-scale-gray-1: #303639;\n  --marknexia-control-hover: #383f42;\n  --marknexia-focus: #b7ff3c;\n  --marknexia-on-primary: #172000;\n  --marknexia-important: #62c3ff;\n  --marknexia-search-current-background: #b7ff3c;\n  --marknexia-search-current-foreground: #172000;\n}\n\nbody {\n  font-family: var(--font-body);\n  font-size: 16px;\n  line-height: 1.5;\n  word-wrap: break-word;\n  background-color: var(--color-canvas-default);\n  color: var(--color-fg-default);\n  margin: 0;\n  padding: 40px 48px 64px;\n}\n\n::selection {\n  color: var(--marknexia-on-primary);\n  background: var(--color-accent-fg);\n}\n\n.markdown-body {\n  box-sizing: border-box;\n  min-width: 200px;\n  max-width: 980px;\n  margin: 0 auto;\n}\n\nh1, h2, h3, h4, h5, h6 {\n  margin-top: 24px;\n  margin-bottom: 16px;\n  font-weight: 600;\n  line-height: 1.25;\n  position: relative;\n}\n\nh1 { font-size: 2em; padding-bottom: .3em; border-bottom: 1px solid var(--color-border-muted); }\nh2 { font-size: 1.5em; padding-bottom: .3em; border-bottom: 1px solid var(--color-border-muted); }\nh3 { font-size: 1.25em; }\nh4 { font-size: 1em; }\nh5 { font-size: .875em; }\nh6 { font-size: .85em; color: var(--color-fg-muted); }\n\n.heading-anchor {\n  opacity: 0;\n  margin-left: -24px;\n  padding-right: 8px;\n  text-decoration: none;\n  color: var(--color-fg-muted);\n  cursor: pointer;\n  transition: opacity 0.2s;\n}\n\nh1:hover .heading-anchor, h2:hover .heading-anchor, h3:hover .heading-anchor,\nh4:hover .heading-anchor, h5:hover .heading-anchor, h6:hover .heading-anchor {\n  opacity: 1;\n}\n\na {\n  color: var(--color-accent-fg);\n  text-decoration: none;\n}\na:hover {\n  text-decoration: underline;\n}\n\np, blockquote, ul, ol, dl, table, pre, details {\n  margin-top: 0;\n  margin-bottom: 16px;\n}\n\nhr {\n  height: .25em;\n  padding: 0;\n  margin: 24px 0;\n  background-color: var(--color-border-default);\n  border: 0;\n}\n\nblockquote {\n  padding: 0 1em;\n  color: var(--color-fg-muted);\n  border-left: .25em solid var(--color-border-default);\n}\n\nul, ol {\n  padding-left: 2em;\n}\n\ntable {\n  border-spacing: 0;\n  border-collapse: collapse;\n  display: block;\n  width: max-content;\n  max-width: 100%;\n  overflow: auto;\n}\n\ntable th, table td {\n  padding: 6px 13px;\n  border: 1px solid var(--color-border-default);\n}\n\ntable th {\n  font-weight: 600;\n  background-color: var(--color-canvas-subtle);\n}\n\ntable tr:nth-child(2n) {\n  background-color: var(--color-canvas-subtle);\n}\n\ncode, tt {\n  padding: .2em .4em;\n  margin: 0;\n  font-size: 85%;\n  white-space: break-spaces;\n  background-color: var(--color-canvas-subtle);\n  border-radius: 6px;\n  font-family: var(--font-mono);\n}\n\npre {\n  padding: 16px;\n  overflow: auto;\n  font-size: 85%;\n  line-height: 1.45;\n  color: var(--color-fg-default);\n  background-color: var(--color-canvas-subtle);\n  border-radius: 6px;\n  font-family: var(--font-mono);\n  position: relative;\n}\n\npre code {\n  padding: 0;\n  background-color: transparent;\n  border-radius: 0;\n}\n\n.code-container {\n  position: relative;\n  margin-bottom: 16px;\n}\n\n.copy-btn {\n  position: absolute;\n  top: 8px;\n  right: 8px;\n  opacity: 0;\n  padding: 4px 8px;\n  font-size: 12px;\n  border: 1px solid var(--color-border-default);\n  border-radius: 6px;\n  background: var(--color-canvas-default);\n  color: var(--color-fg-muted);\n  cursor: pointer;\n  transition: opacity 0.2s, background-color 0.2s;\n}\n\n.copy-btn:focus-visible,\n.marknexia-btn:focus-visible,\na:focus-visible {\n  outline: 2px solid var(--marknexia-focus);\n  outline-offset: 2px;\n}\n\n.code-container:hover .copy-btn {\n  opacity: 1;\n}\n\n.copy-btn:hover {\n  background: var(--marknexia-control-hover);\n  color: var(--color-fg-default);\n}\n\n/* GFM Alerts */\n.markdown-alert {\n  padding: 8px 16px;\n  margin-bottom: 16px;\n  color: inherit;\n  border-left: .25em solid var(--color-border-default);\n  border-radius: 0 6px 6px 0;\n}\n\n.markdown-alert-title {\n  display: flex;\n  font-weight: 500;\n  align-items: center;\n  line-height: 1;\n  margin-bottom: 8px;\n}\n\n.markdown-alert-title svg {\n  margin-right: 8px;\n  fill: currentColor;\n}\n\n.markdown-alert.markdown-alert-note {\n  border-left-color: var(--color-accent-fg);\n}\n.markdown-alert.markdown-alert-note .markdown-alert-title {\n  color: var(--color-accent-fg);\n}\n\n.markdown-alert.markdown-alert-tip {\n  border-left-color: var(--color-success-fg);\n}\n.markdown-alert.markdown-alert-tip .markdown-alert-title {\n  color: var(--color-success-fg);\n}\n\n.markdown-alert.markdown-alert-important {\n  border-left-color: var(--marknexia-important);\n}\n.markdown-alert.markdown-alert-important .markdown-alert-title {\n  color: var(--marknexia-important);\n}\n\n.markdown-alert.markdown-alert-warning {\n  border-left-color: var(--color-attention-fg);\n}\n.markdown-alert.markdown-alert-warning .markdown-alert-title {\n  color: var(--color-attention-fg);\n}\n\n.markdown-alert.markdown-alert-caution {\n  border-left-color: var(--color-danger-fg);\n}\n.markdown-alert.markdown-alert-caution .markdown-alert-title {\n  color: var(--color-danger-fg);\n}\n\n/* Diagrams */\n.marknexia-diagram {\n  border: 1px solid var(--color-border-default);\n  border-radius: 6px;\n  margin-bottom: 16px;\n  background-color: var(--color-canvas-subtle);\n  overflow: hidden;\n}\n\nhtml.marknexia-diagram-expanded,\nhtml.marknexia-diagram-expanded body {\n  overflow: hidden;\n}\n\n.marknexia-diagram.is-expanded {\n  position: fixed;\n  inset: 0;\n  z-index: 1000;\n  display: flex;\n  flex-direction: column;\n  box-sizing: border-box;\n  width: 100vw;\n  height: 100vh;\n  max-width: none;\n  margin: 0;\n  padding: 16px;\n  border-radius: 0;\n}\n\n.marknexia-diagram-toolbar {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 6px 12px;\n  border-bottom: 1px solid var(--color-border-muted);\n  font-size: 12px;\n  color: var(--color-fg-muted);\n}\n\n.marknexia-diagram-viewport {\n  position: relative;\n  min-height: 96px;\n  max-height: min(72vh, 720px);\n  padding: 16px;\n  overflow: auto;\n  background-color: var(--color-canvas-default);\n  cursor: grab;\n}\n\n.marknexia-diagram.is-expanded .marknexia-diagram-viewport {\n  flex: 1 1 auto;\n  min-height: 0;\n  max-height: none;\n}\n\n.marknexia-diagram-viewport.is-panning {\n  cursor: grabbing;\n  user-select: none;\n}\n\n.marknexia-diagram-canvas {\n  width: max-content;\n  min-width: 100%;\n  transform-origin: 0 0;\n  will-change: transform;\n}\n\n.marknexia-diagram-canvas .mermaid {\n  margin: 0;\n  overflow: visible;\n  background: transparent;\n}\n\n.marknexia-btn {\n  padding: 3px 8px;\n  font-size: 12px;\n  border: 1px solid var(--color-border-default);\n  border-radius: 4px;\n  background-color: var(--color-canvas-subtle);\n  color: var(--color-fg-default);\n  cursor: pointer;\n}\n\n.marknexia-btn:hover {\n  background-color: var(--marknexia-control-hover);\n}\n\n.marknexia-diagram-zoom-status {\n  position: absolute;\n  right: 12px;\n  bottom: 8px;\n  padding: 2px 6px;\n  border: 1px solid var(--color-border-muted);\n  border-radius: 4px;\n  color: var(--color-fg-muted);\n  background-color: var(--color-canvas-subtle);\n  font-size: 11px;\n  pointer-events: none;\n}\n\n.marknexia-diagram-error {\n  padding: 16px;\n  background-color: rgba(207, 34, 46, 0.08);\n  border-top: 1px solid var(--color-danger-fg);\n}\n\n.marknexia-diagram-error-title {\n  color: var(--color-danger-fg);\n  font-weight: 600;\n  margin-bottom: 8px;\n}\n\n.marknexia-diagram-error-msg {\n  font-family: var(--font-mono);\n  font-size: 12px;\n  margin-bottom: 12px;\n  color: var(--color-danger-fg);\n}\n\n.marknexia-diagram-fallback {\n  margin-bottom: 16px;\n  padding: 12px 16px;\n  border: 1px solid var(--color-border-default);\n  border-left: 3px solid var(--color-accent-emphasis);\n  border-radius: 6px;\n  color: var(--color-fg-default);\n  background-color: var(--color-canvas-subtle);\n}\n\n.marknexia-diagram-fallback p {\n  margin: 6px 0 10px;\n  color: var(--color-fg-muted);\n}\n\n.marknexia-diagram-fallback details {\n  margin-top: 8px;\n}\n\n.marknexia-diagram-fallback summary {\n  cursor: pointer;\n  color: var(--color-accent-fg);\n}\n\n.marknexia-diagram-fallback pre {\n  max-height: 280px;\n  overflow: auto;\n}\n::highlight(marknexia-search-current) {\n  background-color: var(--marknexia-search-current-background);\n  color: var(--marknexia-search-current-foreground);\n}\n\n/* ColorCode emits token spans inside code blocks. Keep Radium contrast scoped\n   to dark render paths so the established light palette remains untouched. */\n[data-theme=\u0022dark\u0022] pre .kwrd, [data-theme=\u0022dark\u0022] pre .keyword, [data-theme=\u0022dark\u0022] pre .preproc { color: var(--color-accent-fg); }\n[data-theme=\u0022dark\u0022] pre .str, [data-theme=\u0022dark\u0022] pre .string, [data-theme=\u0022dark\u0022] pre .char { color: var(--color-success-fg); }\n[data-theme=\u0022dark\u0022] pre .num, [data-theme=\u0022dark\u0022] pre .number, [data-theme=\u0022dark\u0022] pre .lit { color: #62c3ff; }\n[data-theme=\u0022dark\u0022] pre .type, [data-theme=\u0022dark\u0022] pre .attr { color: var(--color-attention-fg); }\n[data-theme=\u0022dark\u0022] pre .rem, [data-theme=\u0022dark\u0022] pre .comment { color: var(--color-fg-muted); }\n\n@media (prefers-color-scheme: dark) {\n  [data-theme=\u0022system\u0022] pre .kwrd, [data-theme=\u0022system\u0022] pre .keyword, [data-theme=\u0022system\u0022] pre .preproc { color: var(--color-accent-fg); }\n  [data-theme=\u0022system\u0022] pre .str, [data-theme=\u0022system\u0022] pre .string, [data-theme=\u0022system\u0022] pre .char { color: var(--color-success-fg); }\n  [data-theme=\u0022system\u0022] pre .num, [data-theme=\u0022system\u0022] pre .number, [data-theme=\u0022system\u0022] pre .lit { color: #62c3ff; }\n  [data-theme=\u0022system\u0022] pre .type, [data-theme=\u0022system\u0022] pre .attr { color: var(--color-attention-fg); }\n  [data-theme=\u0022system\u0022] pre .rem, [data-theme=\u0022system\u0022] pre .comment { color: var(--color-fg-muted); }\n}\n\n.markdown-body .marknexia-image-fallback {\n  display: inline-flex;\n  align-items: center;\n  max-width: 100%;\n  box-sizing: border-box;\n  padding: 0.35rem 0.55rem;\n  border: 1px solid var(--color-border-default);\n  border-radius: 6px;\n  color: var(--color-fg-muted);\n  background-color: var(--color-canvas-subtle);\n  font-size: 0.875em;\n  line-height: 1.4;\n}\n\n/* Offline, screen-reader-friendly math. The renderer emits semantic HTML and\n   intentionally does not depend on a remote TeX engine or web font. */\n.markdown-body .marknexia-math {\n  white-space: nowrap;\n  font-family: \u0022Cambria Math\u0022, \u0022STIX Two Math\u0022, \u0022Segoe UI Symbol\u0022, serif;\n}\n\n.markdown-body .marknexia-math-display {\n  display: block;\n  margin: 20px 0;\n  overflow-x: auto;\n  padding: 8px 12px;\n  text-align: center;\n  font-size: 1.1em;\n  font-family: \u0022Cambria Math\u0022, \u0022STIX Two Math\u0022, \u0022Segoe UI Symbol\u0022, serif;\n}\n\n.markdown-body .marknexia-math sup,\n.markdown-body .marknexia-math sub,\n.markdown-body .marknexia-math-display sup,\n.markdown-body .marknexia-math-display sub {\n  line-height: 0;\n  font-size: 0.75em;\n}\n\n.markdown-body .marknexia-fraction {\n  display: inline-flex;\n  flex-direction: column;\n  vertical-align: middle;\n  text-align: center;\n  line-height: 1.1;\n  margin: 0 0.15em;\n}\n\n.markdown-body .marknexia-numerator {\n  border-bottom: 1px solid currentColor;\n  padding: 0 0.2em 0.08em;\n}\n\n.markdown-body .marknexia-denominator {\n  padding: 0.08em 0.2em 0;\n}\n\n.markdown-body .marknexia-sqrt {\n  display: inline-flex;\n  align-items: flex-start;\n}\n\n.markdown-body .marknexia-sqrt \u003E span:first-child {\n  font-size: 1.25em;\n  line-height: 0.9;\n  margin-right: 0.08em;\n}\n\n.markdown-body .marknexia-radicand {\n  border-top: 1px solid currentColor;\n  padding: 0 0.15em;\n}\n\n.markdown-body .marknexia-math-fallback {\n  font-family: var(--font-mono);\n  white-space: pre-wrap;\n}\n\n  \u003C/style\u003E\n\u003C/head\u003E\n\u003Cbody\u003E\n  \u003Cdiv class=\u0022markdown-body\u0022\u003E\n\n\u003Cdiv class=\u0022marknexia-diagram marknexia-mermaid\u0022 id=\u0022mermaid-1\u0022\u003E\n  \u003Cdiv class=\u0022marknexia-diagram-toolbar\u0022\u003E\n    \u003Cspan class=\u0022marknexia-diagram-label\u0022\u003EMermaid Diagram\u003C/span\u003E\n    \u003Cdiv class=\u0022marknexia-diagram-actions\u0022\u003E\n      \u003Cbutton type=\u0022button\u0022 class=\u0022marknexia-btn marknexia-btn-copy\u0022 data-marknexia-action=\u0022copy\u0022 data-copy-text=\u0022graph%20TD%0AA--%3EB%0A\u0022 title=\u0022Copy Diagram Source\u0022\u003E\n        Copy\n      \u003C/button\u003E\n      \u003Cbutton type=\u0022button\u0022 class=\u0022mark