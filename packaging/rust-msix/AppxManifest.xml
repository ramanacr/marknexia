<?xml version="1.0" encoding="utf-8"?>
<!--
  Marknexia (Rust preview): MSIX manifest template for CI evidence packages only.
  scripts/New-RustInstallerPackages.ps1 fills in the Identity Version (four numeric parts),
  ProcessorArchitecture (x64 or arm64), Publisher and description tokens. By default the package
  is UNSIGNED: the Publisher carries the unsigned-package OID, so it can be added only with
  Add-AppxPackage -AllowUnsigned. With -Signed (docs/release-signing.md) the Publisher is the
  release certificate's subject, which the owner's signature requires; that changes the
  package family name, so an earlier unsigned preview must be removed before it is installed.
  The identity differs from the .NET edition (RRCLabs.Marknexia), so both install
  side by side. The file type association only adds an "Open with" entry; Windows
  never makes a newly installed package the default app.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="Marknexia.RustPreview"
    ProcessorArchitecture="@ARCHITECTURE@"
    Publisher="@PUBLISHER@"
    Version="@VERSION@" />

  <Properties>
    <DisplayName>Marknexia (Rust preview)</DisplayName>
    <PublisherDisplayName>@PUBLISHER_DISPLAY_NAME@</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>@DESCRIPTION@</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="MarknexiaRustPreview"
      Executable="marknexia-win32.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Marknexia (Rust preview)"
        Description="@TILE_DESCRIPTION@"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="markdown-rust-preview">
            <uap:DisplayName>Markdown document (Marknexia Rust preview)</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.md</uap:FileType>
              <uap:FileType>.markdown</uap:FileType>
              <uap:FileType>.mdown</uap:FileType>
              <uap:FileType>.mkdn</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
