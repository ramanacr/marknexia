<Window x:Class="Marknexia.Setup.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Marknexia Setup"
        Icon="assets/app.ico"
        Width="620"
        Height="470"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F7F9FC"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="112" />
            <RowDefinition Height="*" />
            <RowDefinition Height="68" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#102A56" Padding="26,18">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="assets/marknexia-128.png" Width="68" Height="68" Margin="0,0,18,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Marknexia Setup" Foreground="White" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="GitHub-style Markdown. Native on Windows." Foreground="#C9DCFA" FontSize="13" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="READ · EXPLORE · UNDERSTAND" Foreground="#8EB7F4" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" x:Name="ConfigStepPanel" Margin="28,24" Visibility="Visible">
            <StackPanel>
                <TextBlock Text="Install Marknexia" Foreground="#16243A" FontSize="21" FontWeight="SemiBold" />
                <TextBlock Text="Choose where Marknexia should be installed. Your Markdown files will be registered with Windows and can be previewed from Explorer." Foreground="#526277" FontSize="13" TextWrapping="Wrap" Margin="0,7,0,20" />

                <TextBlock Text="Installation folder" Foreground="#16243A" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,7" />
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TargetDirectoryBox" Grid.Column="0" Height="34" Padding="10,6" VerticalContentAlignment="Center" FontSize="12" />
                    <Button Grid.Column="1" Content="Browse…" Width="92" Height="34" Margin="10,0,0,0" Click="BrowseFolder_Click" />
                </Grid>

                <Border Background="#EAF2FF" BorderBrush="#C9DDFB" BorderThickness="1" CornerRadius="7" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="Included with this installation" Foreground="#174A8B" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="✓ Offline Markdown rendering and Mermaid diagrams" Foreground="#315B8F" FontSize="12" Margin="0,6,0,0" />
                        <TextBlock Text="✓ .md file association with a distinct document icon" Foreground="#315B8F" FontSize="12" Margin="0,3,0,0" />
                        <TextBlock Text="✓ Explorer Preview-pane support and Start menu shortcut" Foreground="#315B8F" FontSize="12" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
                <TextBlock Text="Marknexia installs for the current Windows user and does not require administrator access." Foreground="#718096" FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" x:Name="ProgressStepPanel" Margin="28,24" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Installing Marknexia…" Foreground="#16243A" FontSize="21" FontWeight="SemiBold" />
                <TextBlock x:Name="ProgressStatusText" Text="Preparing the application package…" Foreground="#526277" FontSize="13" Margin="0,8,0,22" />
                <ProgressBar IsIndeterminate="True" Height="8" />
                <TextBlock Text="Registering Markdown associations and Explorer preview support" Foreground="#718096" FontSize="11" Margin="0,16,0,0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" x:Name="CompleteStepPanel" Margin="28,24" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Installation complete" Foreground="#107C41" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Marknexia is ready for your Markdown work." Foreground="#334155" FontSize="14" Margin="0,8,0,16" />
                <Border Background="#ECFDF3" BorderBrush="#B7E4C7" BorderThickness="1" CornerRadius="7" Padding="14,12">
                    <TextBlock Text="You can open .md files directly or use Explorer’s Preview pane to inspect them without leaving the folder." Foreground="#246B45" FontSize="12" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="#EEF2F7" BorderBrush="#D7DFEA" BorderThickness="0,1,0,0" Padding="22,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Cancel" Width="90" Height="34" Margin="0,0,10,0" Click="CancelButton_Click" />
                <Button x:Name="ActionNextButton" Content="Install" Width="108" Height="34" Background="#1F66C1" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Click="ActionNextButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
