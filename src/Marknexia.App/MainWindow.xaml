<Window
    x:Class="Marknexia.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:files="using:Marknexia.Files"
    mc:Ignorable="d"
    Title="Marknexia">

    <Grid Background="{ThemeResource MarknexiaPageBackgroundBrush}" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowWidthStates">
                <VisualState x:Name="WideWindow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="MainSplitView.DisplayMode" Value="Inline" />
                        <Setter Target="MainSplitView.IsPaneOpen" Value="True" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CompactWindow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="BrandDetails.Visibility" Value="Collapsed" />
                        <Setter Target="OpenFileLabel.Visibility" Value="Collapsed" />
                        <Setter Target="OpenFolderLabel.Visibility" Value="Collapsed" />
                        <Setter Target="ThemeSelector.Width" Value="86" />
                        <Setter Target="MainSplitView.OpenPaneLength" Value="240" />
                        <Setter Target="MainSplitView.DisplayMode" Value="Overlay" />
                        <Setter Target="MainSplitView.IsPaneOpen" Value="False" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Command Toolbar -->
        <Grid Grid.Row="0" Background="{ThemeResource MarknexiaSurfaceBrush}" BorderBrush="{ThemeResource MarknexiaBorderBrush}" BorderThickness="0,0,0,1" Padding="12,7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Brand & Sidebar Toggle -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="ToggleSidebarButton" Click="ToggleSidebar_Click" ToolTipService.ToolTip="Toggle Sidebar" AutomationProperties.Name="Toggle sidebar">
                    <FontIcon Glyph="&#xE8A0;" FontSize="16" />
                </Button>
                <Image x:Name="BrandIcon" Source="Assets/marknexia-48.png" Width="28" Height="28" VerticalAlignment="Center" AutomationProperties.Name="Marknexia" />
                <StackPanel x:Name="BrandDetails" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Marknexia" Foreground="{ThemeResource MarknexiaTextBrush}" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Text="Read. Explore. Understand." Foreground="{ThemeResource MarknexiaMutedTextBrush}" FontSize="10" />
                </StackPanel>
            </StackPanel>

            <!-- Navigation Controls -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button x:Name="BackButton" Click="Back_Click" ToolTipService.ToolTip="Back (Alt+Left)" AutomationProperties.Name="Back">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <Button x:Name="ForwardButton" Click="Forward_Click" ToolTipService.ToolTip="Forward (Alt+Right)" AutomationProperties.Name="Forward">
                    <FontIcon Glyph="&#xE72A;" FontSize="14" />
                </Button>
                <Button x:Name="ReloadButton" Click="Reload_Click" ToolTipService.ToolTip="Reload (F5 / Ctrl+R)" AutomationProperties.Name="Reload document">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
                <AppBarSeparator />
                <Button x:Name="OpenFileButton" Click="OpenFile_Click" AutomationProperties.Name="Open Markdown file">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                        <TextBlock x:Name="OpenFileLabel" Text="Open" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="OpenFolderButton" Click="OpenFolder_Click" ToolTipService.ToolTip="Open Folder (Ctrl+Shift+O)" AutomationProperties.Name="Open repository folder">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xED25;" FontSize="14" />
                        <TextBlock x:Name="OpenFolderLabel" Text="Folder" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Right Controls: Search & Theme -->
            <MenuBar Grid.Column="2" VerticalAlignment="Center" AutomationProperties.Name="Application menu">
                <MenuBarItem Title="File">
                    <MenuFlyoutItem Text="Open Markdown file" Click="OpenFile_Click" AutomationProperties.Name="Open Markdown file" />
                    <MenuFlyoutItem Text="Open repository" Click="OpenFolder_Click" AutomationProperties.Name="Open repository" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Close tab" Click="CloseCurrentTab_MenuClick" AutomationProperties.Name="Close current tab" />
                </MenuBarItem>
                <MenuBarItem Title="View">
                    <MenuFlyoutItem Text="Toggle sidebar" Click="ToggleSidebar_Click" AutomationProperties.Name="Toggle sidebar" />
                    <MenuFlyoutItem Text="Find in document" Click="ToggleSearch_Click" AutomationProperties.Name="Find in document" />
                    <MenuFlyoutItem Text="Reload document" Click="Reload_Click" AutomationProperties.Name="Reload document" />
                </MenuBarItem>
                <MenuBarItem Title="Settings">
                    <ToggleMenuFlyoutItem x:Name="RemoteAssetsMenuItem"
                                          Text="Allow remote images (network)"
                                          Click="RemoteAssetsMenuItem_Click"
                                          AutomationProperties.Name="Allow remote images over the network" />
                </MenuBarItem>
                <MenuBarItem Title="Help">
                    <MenuFlyoutItem Text="Keyboard shortcuts" Click="ShowHelp_Click" AutomationProperties.Name="Keyboard shortcuts" />
                    <MenuFlyoutItem Text="Troubleshooting &amp; diagnostics" Click="ShowSelfHelp_Click" AutomationProperties.Name="Troubleshooting and diagnostics" />
                    <MenuFlyoutItem Text="Software components (SBOM)" Click="ShowSbom_Click" AutomationProperties.Name="Software components SBOM" />
                    <MenuFlyoutItem Text="Check for updates" Click="CheckForUpdates_Click" AutomationProperties.Name="Check for updates" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="About Marknexia" Click="ShowAbout_Click" AutomationProperties.Name="About Marknexia" />
                </MenuBarItem>
            </MenuBar>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button x:Name="SearchToggleButton" Click="ToggleSearch_Click" ToolTipService.ToolTip="Find in Document (Ctrl+F)" AutomationProperties.Name="Find in document">
                    <FontIcon Glyph="&#xE721;" FontSize="14" />
                </Button>
                <ComboBox x:Name="ThemeSelector" SelectionChanged="ThemeSelector_SelectionChanged" Width="110" VerticalAlignment="Center" AutomationProperties.Name="Theme">
                    <ComboBoxItem Content="System" Tag="System" IsSelected="True" />
                    <ComboBoxItem Content="Light" Tag="Light" />
                    <ComboBoxItem Content="Dark" Tag="Dark" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- Main Workspace: SplitView for Sidebar and Document View -->
        <SplitView Grid.Row="1" x:Name="MainSplitView" IsPaneOpen="True" DisplayMode="Inline" OpenPaneLength="280">
            <!-- Sidebar Pane -->
            <SplitView.Pane>
                <Grid Background="{ThemeResource MarknexiaSurfaceSubtleBrush}" BorderBrush="{ThemeResource MarknexiaBorderBrush}" BorderThickness="0,0,1,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TabView x:Name="SidebarModeSelector" Grid.Row="0" SelectionChanged="SidebarMode_SelectionChanged" SelectedIndex="0" Margin="8,8,8,4" IsAddTabButtonVisible="False" TabWidthMode="Equal" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Sidebar view">
                        <TabViewItem Header="Outline" />
                        <TabViewItem Header="Repository" />
                    </TabView>

                    <TextBlock x:Name="DocumentMapHeader" Grid.Row="1" Text="Document Map" Foreground="{ThemeResource MarknexiaMutedTextBrush}" FontSize="11" FontWeight="SemiBold" CharacterSpacing="60" Margin="16,8,16,6" />
                    <TextBlock x:Name="RepositoryHeader" Grid.Row="1" Text="Repository" Foreground="{ThemeResource MarknexiaMutedTextBrush}" FontSize="11" FontWeight="SemiBold" CharacterSpacing="60" Margin="16,8,16,6" Visibility="Collapsed" />

                    <!-- Outline List -->
                    <ListView x:Name="OutlineListView" Grid.Row="2" Margin="8,0,8,12" SelectionMode="Single" ItemClick="OutlineItem_Click" IsItemClickEnabled="True" Padding="0" AutomationProperties.Name="Document outline">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="{Binding Margin}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Text}" Foreground="{ThemeResource MarknexiaTextBrush}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Tag="{Binding}" Click="CopyAnchor_Click" Padding="4" ToolTipService.ToolTip="Copy anchor" AutomationProperties.Name="Copy heading anchor">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Hierarchical Repository Explorer -->
                    <TreeView x:Name="RepositoryTreeView" Grid.Row="2" Visibility="Collapsed" SelectionMode="Single" ItemInvoked="RepositoryTreeView_ItemInvoked" Padding="4" AutomationProperties.Name="Repository files">
                        <TreeView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="{Binding Content.Margin}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{Binding Content.IconGlyph}" FontSize="14" Foreground="{ThemeResource MarknexiaAccentBrush}" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Content.DisplayName}" Foreground="{ThemeResource MarknexiaTextBrush}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Tag="{Binding Content}" Click="RevealFile_Click" Padding="4" ToolTipService.ToolTip="Reveal in File Explorer" AutomationProperties.Name="Reveal in File Explorer">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="11" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <Border x:Name="SidebarResizeHandle" Grid.RowSpan="3" Width="6" HorizontalAlignment="Right" Background="Transparent" ToolTipService.ToolTip="Drag to resize sidebar" AutomationProperties.Name="Resize sidebar"
                            PointerPressed="SidebarResizeHandle_PointerPressed" PointerMoved="SidebarResizeHandle_PointerMoved" PointerReleased="SidebarResizeHandle_PointerReleased" PointerCaptureLost="SidebarResizeHandle_PointerCaptureLost" />
                </Grid>
            </SplitView.Pane>

            <!-- Document Tabs Workspace -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Search Bar Floating Header -->
                <Grid x:Name="SearchBarGrid" Grid.Row="0" Visibility="Collapsed" Background="{ThemeResource MarknexiaSurfaceBrush}" BorderBrush="{ThemeResource MarknexiaBorderBrush}" BorderThickness="0,0,0,1" Padding="12,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchInputBox" PlaceholderText="Find in document..." KeyDown="SearchBox_KeyDown" TextChanged="SearchInputBox_TextChanged" Margin="0,0,8,0" AutomationProperties.Name="Find in document" />
                    <TextBlock x:Name="SearchCountText" Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource MarknexiaMutedTextBrush}" FontSize="12" Margin="0,0,8,0" />
                    <Button Grid.Column="2" Click="FindPrevious_Click" ToolTipService.ToolTip="Previous" AutomationProperties.Name="Find previous match" Margin="0,0,4,0">
                        <FontIcon Glyph="&#xE70E;" FontSize="12" />
                    </Button>
                    <Button Grid.Column="3" Click="FindNext_Click" ToolTipService.ToolTip="Next" AutomationProperties.Name="Find next match" Margin="0,0,8,0">
                        <FontIcon Glyph="&#xE70D;" FontSize="12" />
                    </Button>
                    <Button Grid.Column="4" Click="CloseSearch_Click" ToolTipService.ToolTip="Close" AutomationProperties.Name="Close find bar">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </Grid>

                <!-- Non-blocking Diagnostic InfoBar -->
                <InfoBar x:Name="DiagnosticInfoBar" Grid.Row="1" IsOpen="False" Severity="Warning" Margin="8,4" />

                <!-- Document tabs and viewer -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TabView x:Name="DocumentTabsView" Grid.Row="0" SelectionChanged="DocumentTabs_SelectionChanged" TabItemsChanged="DocumentTabs_TabItemsChanged" TabCloseRequested="DocumentTabs_TabCloseRequested" IsAddTabButtonVisible="False" CanReorderTabs="True" TabWidthMode="SizeToContent" CloseButtonOverlayMode="OnPointerOver" Background="{ThemeResource MarknexiaSurfaceBrush}" BorderBrush="{ThemeResource MarknexiaBorderBrush}" BorderThickness="0,0,0,1" AutomationProperties.Name="Open documents" />
                    <Grid Grid.Row="1" x:Name="DocumentHost">
                        <StackPanel x:Name="WelcomePanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560" Spacing="12">
                            <Image Source="Assets/marknexia-128.png" Width="88" Height="88" HorizontalAlignment="Center" />
                            <TextBlock Text="Marknexia" Foreground="{ThemeResource MarknexiaTextBrush}" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Read. Explore. Understand." Foreground="{ThemeResource MarknexiaAccentBrush}" FontSize="16" HorizontalAlignment="Center" />
                            <TextBlock Text="GitHub-style Markdown. Native on Windows." Foreground="{ThemeResource MarknexiaMutedTextBrush}" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,8" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                <Button Click="OpenFile_Click" Background="{ThemeResource MarknexiaPrimaryBrush}" Foreground="White" AutomationProperties.Name="Open Markdown file">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                                        <TextBlock Text="Open Markdown file" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Click="OpenFolder_Click" AutomationProperties.Name="Open repository">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xED25;" FontSize="14" />
                                        <TextBlock Text="Open repository" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Open a file or folder to begin." Foreground="{ThemeResource MarknexiaMutedTextBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,0" AutomationProperties.Name="Open a file or folder to begin" />
                            <TextBlock x:Name="RecentFilesLabel" Text="RECENT FILES" Foreground="{ThemeResource MarknexiaMutedTextBrush}" FontSize="11" FontWeight="SemiBold" CharacterSpacing="80" HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed" />
                            <ListView x:Name="RecentFilesListView" Width="420" MaxHeight="150" SelectionMode="None" IsItemClickEnabled="True" ItemClick="RecentFile_ItemClick" Visibility="Collapsed" AutomationProperties.Name="Recent Markdown files">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="{ThemeResource MarknexiaTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Padding="8,4" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                        <ContentPresenter x:Name="DocumentContentPresenter" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        <Grid x:Name="LoadingOverlay" Visibility="Collapsed" Background="{ThemeResource MarknexiaSurfaceBrush}" Opacity="0.96">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                <ProgressRing x:Name="LoadingIndicator" IsActive="True" Width="34" Height="34" HorizontalAlignment="Center" />
                                <TextBlock Text="Preparing document…" Foreground="{ThemeResource MarknexiaMutedTextBrush}" FontSize="13" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </SplitView>
    </Grid>
</Window>
