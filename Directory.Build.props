<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>13.0</LangVersion>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <Company>Marknexia</Company>
    <Product>Marknexia</Product>
    <Copyright>Copyright (c) 2026 Marknexia</Copyright>
    <!-- Base Semantic Versioning -->
    <VersionMajor Condition="'$(VersionMajor)' == ''">1</VersionMajor>
    <VersionMinor Condition="'$(VersionMinor)' == ''">0</VersionMinor>
    <VersionPatch Condition="'$(VersionPatch)' == ''">2</VersionPatch>
    <BuildNumber Condition="'$(GITHUB_RUN_NUMBER)' != ''">$(GITHUB_RUN_NUMBER)</BuildNumber>
    <BuildNumber Condition="'$(BuildNumber)' == ''">0</BuildNumber>
    <!-- Package and Assembly Version defaults -->
    <Version Condition="'$(Version)' == ''">$(VersionMajor).$(VersionMinor).$(VersionPatch)</Version>
    <PackageVersion Condition="'$(PackageVersion)' == ''">$(VersionMajor).$(VersionMinor).$(VersionPatch)</PackageVersion>
    <AssemblyVersion>$(VersionMajor).$(VersionMinor).0.0</AssemblyVersion>
    <FileVersion>$(VersionMajor).$(VersionMinor).$(BuildNumber).0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
  </PropertyGroup>
  <!-- Auto-increment versioning from git commit count -->
  <Target Name="DetermineGitVersion" BeforeTargets="BeforeBuild;GetAssemblyVersion;GenerateNuspec" Condition="'$(BuildNumber)' == '0'">
    <Exec Command="git rev-list --count HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitCount" />
    </Exec>
    <PropertyGroup Condition="'$(GitCommitCount)' != '' And '$(GitCommitCount)' != '0'">
      <BuildNumber>$(GitCommitCount)</BuildNumber>
      <FileVersion>$(VersionMajor).$(VersionMinor).$(BuildNumber).0</FileVersion>
      <PackageVersion Condition="'$(VersionSuffix)' == ''">$(VersionMajor).$(VersionMinor).$(BuildNumber)</PackageVersion>
      <PackageVersion Condition="'$(VersionSuffix)' != ''">$(VersionMajor).$(VersionMinor).$(BuildNumber)-$(VersionSuffix)</PackageVersion>
      <InformationalVersion>$(VersionMajor).$(VersionMinor).$(BuildNumber)</InformationalVersion>
    </PropertyGroup>
  </Target>
</Project>